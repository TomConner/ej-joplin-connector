{
  "name": "joplin-mcp",
  "version": "1.0.0",
  "description": "MCP server for Joplin Data API integration",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "codex:setup": "node scripts/codex-setup.js",
    "codex:skills:install": "node scripts/install-codex-skill.js",
    "codex:skill:install": "npm run codex:skills:install",
    "codex:install": "npm run build && npm run codex:setup && npm run codex:skills:install",
    "clean": "rm -rf server dist",
    "pack": "npm run build && npm install --omit=dev --ignore-scripts && mcpb pack",
    "test": "node server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
